{
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "tests/**",
      "e2e/**",
      "!**/database.types.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true
  }
}
