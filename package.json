{
  "name": "2b-studio-test",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12.1 <27",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "db:dev": "node scripts/supabase-local.mjs dev",
    "db:test": "node scripts/supabase-local.mjs test",
    "test:infra": "node --test scripts/*.test.mjs",
    "test:mutation": "node scripts/test-mutation.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src scripts tests e2e --diagnostic-level=warn",
    "format:check": "biome format src",
    "test": "pnpm test:infra && vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:artifacts",
    "test:db": "node scripts/test-database.mjs",
    "test:api": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test:e2e": "node scripts/demo-e2e.mjs",
    "demo:start": "node scripts/demo.mjs start",
    "demo:stop": "node scripts/demo.mjs stop",
    "check:artifacts": "node scripts/artifact-secrets.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "pg": "8.23.1",
    "supabase": "3.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "lucide-react": "1.67.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "tailwindcss": "4.3.4",
    "zod": "4.6.7"
  }
}
